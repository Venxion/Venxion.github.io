        </div>
        <div class="project-links">
          <a href="#">GitHub repo</a>
          <a href="#">Full write-up</a>
        </div>
      </div>
    </article>

    <!-- Project 2 -->
    <article class="project-sheet">
      <div class="project-media">
        <svg viewBox="0 0 260 200">
          <rect x="50" y="80" width="160" height="60"/>
          <circle cx="80" cy="150" r="18"/>
          <circle cx="180" cy="150" r="18"/>
          <line x1="130" y1="80" x2="130" y2="40"/>
          <line class="accent" x1="110" y1="40" x2="150" y2="40"/>
          <line x1="110" y1="40" x2="110" y2="55"/>
          <line x1="150" y1="40" x2="150" y2="55"/>
        </svg>
      </div>
      <div class="project-body">
